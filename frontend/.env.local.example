# Copy to .env.local for local dev. Do NOT commit .env.local.

# Where the frontend can reach Drupal *from the server* — typically the
# in-container hostname when running under DDEV, or the public URL otherwise.
DRUPAL_BASE_URL=http://web/

# Where the *browser* should reach Drupal. Used for image URLs.
NEXT_PUBLIC_DRUPAL_BASE_URL=https://drupal-headless-starter.ddev.site

# OAuth consumer credentials, printed by drupal/scripts/install.sh.
DRUPAL_CLIENT_ID=nextjs-frontend
DRUPAL_CLIENT_SECRET=replace-me

# Shared secret with Drupal — used by the /api/preview handshake.
DRUPAL_PREVIEW_SECRET=dev-preview-secret-change-me

# Where Drupal should redirect back to after editor preview / OAuth flows.
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
