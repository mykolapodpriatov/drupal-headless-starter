# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp
*.swo

# Node
node_modules/
.next/
out/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Env
.env
.env.local
.env.*.local

# Drupal — scaffolded files and runtime artefacts
drupal/web/core/
drupal/web/libraries/
drupal/web/modules/contrib/
drupal/web/profiles/contrib/
drupal/web/themes/contrib/
drupal/vendor/
drupal/web/sites/*/files/
