drupal/web/sites/*/services.local.yml

# OAuth keys — never commit
drupal/keys/*.key
drupal/keys/*.pem
!drupal/keys/.gitkeep

# DDEV
.ddev/.global_commands/
.ddev/db_snapshots/
.ddev/import-db/
.ddev/import.yaml
.ddev/providers/

