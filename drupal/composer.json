{
    "name": "korgalom/drupal-headless-starter",
    "description": "Drupal 11 backend for a headless/decoupled Next.js stack.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.3",
        "composer/installers": "^2.3",
        "drupal/core-composer-scaffold": "^11",
        "drupal/core-project-message": "^11",
        "drupal/core-recommended": "^11",
        "drupal/decoupled_router": "^2.0",
        "drupal/graphql_compose": "^2.1",
        "drupal/jsonapi_extras": "^3.27",
        "drupal/restui": "^1.22",
        "drupal/simple_oauth": "^6.0",
        "drupal/subrequests": "^3.0",
        "drush/drush": "^13.0"
    },
    "require-dev": {
        "drupal/core-dev": "^11",
        "phpstan/phpstan": "^1.11",
        "mglaman/phpstan-drupal": "^1.3",
        "squizlabs/php_codesniffer": "^3.10",
        "drupal/coder": "^8.3"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "conflict": {
        "drupal/drupal": "*"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            },
            "file-mapping": {
                "[web-root]/sites/default/default.settings.php": false,
                "[web-root]/sites/default/default.services.yml": false
            }
        },
        "installer-paths": {
            "web/core": ["type:drupal-core"],
            "web/libraries/{$name}": ["type:drupal-library"],
            "web/modules/contrib/{$name}": ["type:drupal-module"],
            "web/profiles/contrib/{$name}": ["type:drupal-profile"],
            "web/themes/contrib/{$name}": ["type:drupal-theme"],
            "drush/Commands/contrib/{$name}": ["type:drupal-drush"],
            "web/modules/custom/{$name}": ["type:drupal-custom-module"],
            "web/themes/custom/{$name}": ["type:drupal-custom-theme"],
            "recipes/{$name}": ["type:drupal-recipe"]
        }
    },
    "autoload": {
        "psr-4": {
            "Drupal\\Custom\\": "web/modules/custom/"
        }
    },
    "scripts": {
        "phpcs": "phpcs --standard=Drupal,DrupalPractice web/modules/custom",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "post-install-cmd": [
            "@php -r \"file_exists('web/sites/default/settings.php') || copy('web/sites/default/default.settings.php', 'web/sites/default/settings.php');\""
        ]
    }
}
